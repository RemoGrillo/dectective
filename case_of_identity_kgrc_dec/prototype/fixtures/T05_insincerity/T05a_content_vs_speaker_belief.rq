PREFIX st: <http://example.org/dectective/story/>
PREFIX w: <http://example.org/dectective/world/>
PREFIX prof: <http://example.org/dectective/profile#>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX dec: <http://w3id.org/conjectures/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?content WHERE { ?act prof:hasContent ?content ; crm:P14_carried_out_by ?sp . ?sp prof:believes ?bw . ?content dec:disagreesWith ?bw . }
