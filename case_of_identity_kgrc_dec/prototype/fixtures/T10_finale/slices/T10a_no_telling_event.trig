@prefix ns1: <http://www.cidoc-crm.org/extensions/crminf/> .
@prefix ns2: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix ns3: <http://example.org/dectective/profile#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

{
    <http://example.org/dectective/story/adoption_mary> a ns1:I7_Belief_Adoption ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/mary> ;
        ns1:J2_concluded_that <http://example.org/dectective/story/belief_mary_D1> ;
        ns1:J7_is_based_on_evidence_from <http://example.org/dectective/story/letter_H1> .

    <http://example.org/dectective/story/ca_holmes_explanation> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/watson> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/holmes> .

    <http://example.org/dectective/story/ca_holmes_prediction> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/watson> ;
        ns3:hasContent <http://example.org/dectective/world/holmes_prediction> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/holmes> .

    <http://example.org/dectective/story/ca_holmes_reconstruction> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/windibank> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/holmes> .

    <http://example.org/dectective/story/ca_hosmer_cashier> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/mary> ;
        ns3:reportedBy <http://example.org/dectective/story/mary> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/hosmer> .

    <http://example.org/dectective/story/ca_mary_france> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/holmes> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/mary> .

    <http://example.org/dectective/story/ca_windibank_delighted> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/holmes> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/ca_windibank_machine> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/holmes> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/ca_windibank_reassure> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/mary> ;
        ns3:reportedBy <http://example.org/dectective/story/mary> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/inference_holmes> a ns1:I5_Inference_Making ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/holmes> ;
        ns1:J2_concluded_that <http://example.org/dectective/story/belief_holmes_identity> ;
        ns1:J3_applied <http://example.org/dectective/story/logic_convergent_abduction> .

    <http://example.org/dectective/story/letter_H2> a ns3:TypewrittenLetter ;
        ns3:purportsToBeFrom <http://example.org/dectective/story/hosmer> ;
        ns3:typedOn <http://example.org/dectective/story/machine_H> .

    <http://example.org/dectective/story/letter_H3> a ns3:TypewrittenLetter ;
        ns3:purportsToBeFrom <http://example.org/dectective/story/hosmer> ;
        ns3:typedOn <http://example.org/dectective/story/machine_H> .

    <http://example.org/dectective/story/letter_H4> a ns3:TypewrittenLetter ;
        ns3:purportsToBeFrom <http://example.org/dectective/story/hosmer> ;
        ns3:typedOn <http://example.org/dectective/story/machine_H> .

    <http://example.org/dectective/story/letter_W> a ns3:TypewrittenLetter ;
        ns3:showsDefectProfile <http://example.org/dectective/story/profile_eR14> ;
        ns3:typedOn <http://example.org/dectective/story/office_machine> ;
        ns3:writtenBy <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/reaction_start> a ns2:E5_Event ;
        ns2:P11_had_participant <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/world/shared> a <http://w3id.org/conjectures/sharedWorld> .

    ns3:believes a <http://w3id.org/conjectures/doxasticPredicate> .

    <http://example.org/dectective/story/disappearance> a ns3:Disappearance ;
        ns3:disappearedPerson <http://example.org/dectective/story/hosmer> .

    <http://example.org/dectective/story/journey_france_1> a ns3:Journey ;
        ns3:traveller <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/journey_france_2> a ns3:Journey ;
        ns3:traveller <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/app_hosmer_angel> a ns2:E41_Appellation ;
        rdfs:label "Hosmer Angel" .

    <http://example.org/dectective/story/app_mary_sutherland> a ns2:E41_Appellation ;
        rdfs:label "Mary Sutherland" .

    <http://example.org/dectective/story/app_windibank> a ns2:E41_Appellation ;
        rdfs:label "Windibank" .

    <http://example.org/dectective/story/belief_holmes_identity> a ns1:I2_Belief ;
        ns3:heldBy <http://example.org/dectective/story/holmes> ;
        ns1:J4_that <http://example.org/dectective/world/holmes_reconstruction> ;
        ns1:J5_holds_to_be "TRUE" .

    <http://example.org/dectective/story/belief_mary_D1> a ns1:I2_Belief ;
        ns3:heldBy <http://example.org/dectective/story/mary> ;
        ns1:J4_that <http://example.org/dectective/world/mary_D1> ;
        ns1:J5_holds_to_be "TRUE" .

    <http://example.org/dectective/story/letter_H1> a ns3:TypewrittenLetter ;
        ns3:purportsToBeFrom <http://example.org/dectective/story/hosmer> ;
        ns3:showsDefectProfile <http://example.org/dectective/story/profile_eR14> ;
        ns3:typedOn <http://example.org/dectective/story/machine_H> .

    <http://example.org/dectective/story/mother> a ns2:E21_Person .

    <http://example.org/dectective/story/occ_wine_traveller> a ns3:Occupation .

    <http://example.org/dectective/story/westhouse_marbank> a ns2:E74_Group .

    <http://example.org/dectective/story/ball> a ns2:E5_Event .

    <http://example.org/dectective/story/holmes> a ns2:E21_Person ;
        ns3:believes <http://example.org/dectective/world/holmes_prediction> .

    <http://example.org/dectective/story/hosmer> a ns2:E21_Person ;
        ns3:attended <http://example.org/dectective/story/ball> ;
        ns3:wore <http://example.org/dectective/story/tinted_glasses> ;
        ns2:P1_is_identified_by <http://example.org/dectective/story/app_hosmer_angel> .

    <http://example.org/dectective/story/mary> a ns2:E21_Person ;
        ns3:attended <http://example.org/dectective/story/ball> ;
        ns3:believes <http://example.org/dectective/world/mary_D1> ;
        ns3:engagedTo <http://example.org/dectective/story/hosmer> ;
        ns2:P1_is_identified_by <http://example.org/dectective/story/app_mary_sutherland> .

    <http://example.org/dectective/story/windibank> a ns3:KeenSighted,
            ns2:E21_Person ;
        ns3:employedBy <http://example.org/dectective/story/westhouse_marbank> ;
        ns3:hasOccupation <http://example.org/dectective/story/occ_wine_traveller> ;
        ns3:spouseOf <http://example.org/dectective/story/mother> ;
        ns3:stepfatherOf <http://example.org/dectective/story/mary> ;
        ns2:P1_is_identified_by <http://example.org/dectective/story/app_windibank> .
}

<http://example.org/dectective/world/mary_D1> {
    <http://example.org/dectective/story/disappearance> a ns3:InvoluntaryDisappearance ;
        ns3:disappearedPerson <http://example.org/dectective/story/hosmer> .

    <http://example.org/dectective/story/journey_france_1> a ns3:ActualJourney ;
        ns3:traveller <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/journey_france_2> a ns3:ActualJourney ;
        ns3:traveller <http://example.org/dectective/story/windibank> .

    <http://example.org/dectective/story/mary> ns3:engagedTo <http://example.org/dectective/story/hosmer> .

    <http://example.org/dectective/story/hosmer> a ns3:ExpectedToReturn,
            ns3:WeakSighted ;
        ns3:hasOccupation <http://example.org/dectective/story/occ_cashier_leadenhall> .
}

<http://example.org/dectective/world/holmes_prediction> {
    <http://example.org/dectective/story/hyp_reaction> ns3:rejects <http://example.org/dectective/story/hyp_telling> .

    <http://example.org/dectective/story/hyp_telling> a ns3:CommunicativeAct ;
        ns3:addressee <http://example.org/dectective/story/mary> ;
        ns2:P14_carried_out_by <http://example.org/dectective/story/holmes> .
}

<http://example.org/dectective/world/shared> {
    ns2:E1_CRM_Entity a rdfs:Class .

    ns2:E2_Temporal_Entity a rdfs:Class ;
        rdfs:subClassOf ns2:E1_CRM_Entity .

    ns2:E39_Actor a rdfs:Class ;
        rdfs:subClassOf ns2:E77_Persistent_Item .

    ns2:E4_Period a rdfs:Class ;
        rdfs:subClassOf ns2:E2_Temporal_Entity,
            ns2:E92_Spacetime_Volume .

    ns2:E5_Event a rdfs:Class ;
        rdfs:subClassOf ns2:E4_Period .

    ns2:E77_Persistent_Item a rdfs:Class ;
        rdfs:subClassOf ns2:E1_CRM_Entity .

    ns2:E7_Activity a rdfs:Class ;
        rdfs:subClassOf ns2:E5_Event .

    ns2:E92_Spacetime_Volume a rdfs:Class ;
        rdfs:subClassOf ns2:E1_CRM_Entity .

    ns3:addressee a owl:ObjectProperty .

    ns3:attended a owl:ObjectProperty .

    ns3:disappearedPerson a owl:ObjectProperty .

    ns3:employedBy a owl:ObjectProperty .

    ns3:engagedTo a owl:ObjectProperty,
            owl:SymmetricProperty .

    ns3:hasContent a owl:ObjectProperty .

    ns3:hasOccupation a owl:ObjectProperty .

    ns3:heldBy a owl:ObjectProperty .

    ns3:purportsToBeFrom a owl:ObjectProperty .

    ns3:rejects a owl:ObjectProperty .

    ns3:reportedBy a owl:ObjectProperty .

    ns3:showsDefectProfile a owl:ObjectProperty .

    ns3:spouseOf a owl:ObjectProperty,
            owl:SymmetricProperty .

    ns3:stepfatherOf a owl:ObjectProperty .

    ns3:traveller a owl:ObjectProperty .

    ns3:typedOn a owl:ObjectProperty .

    ns3:wore a owl:ObjectProperty .

    ns3:writtenBy a owl:ObjectProperty .

    ns2:P14_carried_out_by a rdf:Property ;
        rdfs:domain ns2:E7_Activity ;
        rdfs:range ns2:E39_Actor ;
        rdfs:subPropertyOf ns2:P11_had_participant ;
        owl:inverseOf ns2:P14i_performed .

    ns3:ExpectedToReturn a owl:Class .

    ns3:InvoluntaryDisappearance a owl:Class ;
        rdfs:subClassOf ns3:Disappearance .

    ns3:Letter a owl:Class .

    ns3:Occupation a owl:Class .

    ns3:WeakSighted a owl:Class ;
        owl:disjointWith ns3:KeenSighted .

    ns3:believes a owl:ObjectProperty .

    ns2:P11_had_participant a rdf:Property ;
        rdfs:domain ns2:E5_Event ;
        rdfs:range ns2:E39_Actor ;
        rdfs:subPropertyOf ns2:P12_occurred_in_the_presence_of ;
        owl:inverseOf ns2:P11i_participated_in .

    ns2:P12_occurred_in_the_presence_of a rdf:Property ;
        rdfs:domain ns2:E5_Event ;
        rdfs:range ns2:E77_Persistent_Item ;
        owl:inverseOf ns2:P12i_was_present_at .

    ns3:ActualJourney a owl:Class ;
        rdfs:subClassOf ns3:Journey .

    ns3:Disappearance a owl:Class .

    ns3:KeenSighted a owl:Class .

    ns3:Journey a owl:Class .

    ns3:TypewrittenLetter a owl:Class ;
        rdfs:subClassOf ns3:Letter .

    ns3:CommunicativeAct a owl:Class .
}

