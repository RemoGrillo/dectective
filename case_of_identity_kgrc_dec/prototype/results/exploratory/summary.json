{
  "E01_verbatim": {
    "checks": [
      {
        "world": "V",
        "triple": ":x type :A",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "verbatim keeps its content"
      },
      {
        "world": "V",
        "triple": ":x type :B",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "no inference inside verbatim (paper §5.1, README)"
      },
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":x type :A",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "verbatim content does not permeate to reality"
      }
    ],
    "sparql_probes": [],
    "world_types": {
      ":S": "named/shared",
      ":V": "named/verbatim",
      "dec:reality": "default/reality"
    },
    "dec_diagnostics": [
      ":S http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:sharedWorld",
      ":V http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:verbatimWorld",
      ":said http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:verbatimPredicate"
    ]
  },
  "E02_doxastic": {
    "checks": [
      {
        "world": "D",
        "triple": ":x type :B",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "doxastic receives shared and infers locally"
      },
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":x type :A",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "doxastic does not permeate to reality"
      },
      {
        "world": "D",
        "triple": ":y type :A",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "reality does not enter a doxastic world"
      }
    ],
    "sparql_probes": [
      {
        "query": "ASK { GRAPH dec:reality { :x a :A } }",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "SPARQL: doxastic content absent from reality"
      },
      {
        "query": "ASK { GRAPH :D { :x a :B } }",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "SPARQL: local inference visible inside the doxastic world"
      }
    ],
    "world_types": {
      ":D": "named/doxastic",
      ":S": "named/shared",
      "dec:reality": "default/reality"
    },
    "dec_diagnostics": [
      ":D http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:doxasticWorld",
      ":S http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:sharedWorld",
      ":believes http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:doxasticPredicate"
    ]
  },
  "E03_epistemic": {
    "checks": [
      {
        "world": "K",
        "triple": ":x type :B",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "epistemic infers locally with shared"
      },
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":x type :A",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "epistemic content permeates to reality"
      },
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":x type :B",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "epistemic consequences are factual in reality"
      }
    ],
    "sparql_probes": [
      {
        "query": "ASK { GRAPH dec:reality { :x a :B } }",
        "expected": true,
        "observed": false,
        "verdict": "DIFFERS",
        "note": "SPARQL: epistemic consequence visible in GRAPH dec:reality"
      },
      {
        "query": "ASK { :x a :B }",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "SPARQL: epistemic consequence visible in the default graph"
      }
    ],
    "world_types": {
      ":K": "named/epistemic",
      ":S": "named/shared",
      "dec:reality": "default/reality"
    },
    "dec_diagnostics": [
      ":K http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:epistemicWorld",
      ":S http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:sharedWorld",
      ":knows http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:epistemicPredicate"
    ]
  },
  "E04_conjectural": {
    "checks": [
      {
        "world": "C",
        "triple": ":x type :Z",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "conjectural receives reality and infers with its hypothesis"
      },
      {
        "world": "C",
        "triple": ":x type :B",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "conjectural receives shared consequences"
      },
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":x type :Z",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "conjectural consequences do not go back to reality"
      }
    ],
    "sparql_probes": [
      {
        "query": "ASK { GRAPH :C { :x a :Z } }",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "SPARQL: conjectural consequence visible in its world"
      },
      {
        "query": "ASK { GRAPH dec:reality { :x a :Z } }",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "SPARQL: conjectural consequence absent from reality"
      }
    ],
    "world_types": {
      ":C": "named/conjectural",
      ":S": "named/shared",
      "dec:reality": "default/reality"
    },
    "dec_diagnostics": [
      ":C http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:conjecturalWorld",
      ":S http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:sharedWorld",
      ":supposes http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:conjecturalPredicate"
    ]
  },
  "E05_default_named": {
    "checks": [
      {
        "world": "U",
        "triple": ":x type :B",
        "expected": true,
        "observed": false,
        "verdict": "DIFFERS",
        "note": "paper §5.1: untyped named graph defaults to a doxastic world (local inference)"
      },
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":x type :A",
        "expected": null,
        "observed": false,
        "verdict": "observed-only",
        "note": "observe: does an untyped named graph permeate to reality?"
      }
    ],
    "sparql_probes": [],
    "world_types": {
      ":S": "named/shared",
      ":U": "named/verbatim",
      "dec:reality": "default/reality"
    },
    "dec_diagnostics": [
      ":S http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:sharedWorld"
    ]
  },
  "E06_identity": {
    "checks": [
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":clark canDo :flying",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "Lois's belief does not become a fact"
      },
      {
        "world": "LoisB",
        "triple": ":clark canDo :flying",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "Superman paradox blocked: reality's sameAs does not enter a doxastic world"
      },
      {
        "world": "LoisC",
        "triple": ":clark canDo :flying",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "conjectural world receives reality's sameAs: substitution happens there"
      },
      {
        "world": "JimmyB",
        "triple": ":clark canDo :flying",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "identity asserted inside a doxastic world substitutes locally"
      }
    ],
    "sparql_probes": [
      {
        "query": "ASK { GRAPH :LoisB { :clark :canDo :flying } }",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "SPARQL: no Superman substitution in Lois's doxastic world"
      },
      {
        "query": "ASK { GRAPH :LoisC { :clark :canDo :flying } }",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "SPARQL: substitution in the conjectural world"
      }
    ],
    "world_types": {
      ":JimmyB": "named/doxastic",
      ":LoisB": "named/doxastic",
      ":LoisC": "named/conjectural",
      ":S": "named/shared",
      "dec:reality": "default/reality"
    },
    "dec_diagnostics": [
      ":JimmyB http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:doxasticWorld",
      ":LoisB http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:doxasticWorld",
      ":LoisC http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:conjecturalWorld",
      ":S http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:sharedWorld",
      ":believes http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:doxasticPredicate",
      ":supposes http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:conjecturalPredicate"
    ]
  },
  "E07_nested": {
    "checks": [
      {
        "world": "MaryB",
        "triple": ":x type :B",
        "expected": null,
        "observed": false,
        "verdict": "observed-only",
        "note": "observe: is a world governed only from INSIDE another world recognised (inference with shared)?"
      },
      {
        "world": "HolmesB",
        "triple": ":mary believes :MaryB",
        "expected": true,
        "observed": true,
        "verdict": "as documented",
        "note": "Holmes's world keeps the attribution"
      },
      {
        "world": "http://w3id.org/conjectures/reality",
        "triple": ":mary believes :MaryB",
        "expected": false,
        "observed": false,
        "verdict": "as documented",
        "note": "the inner attribution is not a fact"
      }
    ],
    "sparql_probes": [
      {
        "query": "ASK { GRAPH :MaryB { :x a :B } }",
        "expected": null,
        "observed": false,
        "verdict": "observed-only",
        "note": "SPARQL: inner world gets inference with shared?"
      }
    ],
    "world_types": {
      ":HolmesB": "named/doxastic",
      ":MaryB": "named/verbatim",
      ":S": "named/shared",
      "dec:reality": "default/reality"
    },
    "dec_diagnostics": [
      ":HolmesB http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:doxasticWorld",
      ":S http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:sharedWorld",
      ":believes http://www.w3.org/1999/02/22-rdf-syntax-ns#type dec:doxasticPredicate"
    ]
  },
