@prefix ns1: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/dectective/world/shared> {
    ns1:E18_Physical_Thing a rdfs:Class ;
        rdfs:subClassOf ns1:E72_Legal_Object .

    ns1:E19_Physical_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E18_Physical_Thing .

    ns1:E1_CRM_Entity a rdfs:Class .

    ns1:E20_Biological_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E19_Physical_Object .

    ns1:E21_Person a rdfs:Class ;
        rdfs:subClassOf ns1:E20_Biological_Object,
            ns1:E39_Actor .

    ns1:E22_Human-Made_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E19_Physical_Object,
            ns1:E24_Physical_Human-Made_Thing .

    ns1:E24_Physical_Human-Made_Thing a rdfs:Class ;
        rdfs:subClassOf ns1:E18_Physical_Thing,
            ns1:E71_Human-Made_Thing .

    ns1:E28_Conceptual_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E71_Human-Made_Thing .

    ns1:E2_Temporal_Entity a rdfs:Class ;
        rdfs:subClassOf ns1:E1_CRM_Entity .

    ns1:E31_Document a rdfs:Class ;
        rdfs:subClassOf ns1:E73_Information_Object .

    ns1:E39_Actor a rdfs:Class ;
        rdfs:subClassOf ns1:E77_Persistent_Item .

    ns1:E41_Appellation a rdfs:Class ;
        rdfs:subClassOf ns1:E90_Symbolic_Object .

    ns1:E4_Period a rdfs:Class ;
        rdfs:subClassOf ns1:E2_Temporal_Entity,
            ns1:E92_Spacetime_Volume .

    ns1:E52_Time-Span a rdfs:Class ;
        rdfs:subClassOf ns1:E1_CRM_Entity .

    ns1:E55_Type a rdfs:Class ;
        rdfs:subClassOf ns1:E28_Conceptual_Object .

    ns1:E5_Event a rdfs:Class ;
        rdfs:subClassOf ns1:E4_Period .

    ns1:E70_Thing a rdfs:Class ;
        rdfs:subClassOf ns1:E77_Persistent_Item .

    ns1:E71_Human-Made_Thing a rdfs:Class ;
        rdfs:subClassOf ns1:E70_Thing .

    ns1:E72_Legal_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E70_Thing .

    ns1:E73_Information_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E89_Propositional_Object,
            ns1:E90_Symbolic_Object .

    ns1:E74_Group a rdfs:Class ;
        rdfs:subClassOf ns1:E39_Actor .

    ns1:E77_Persistent_Item a rdfs:Class ;
        rdfs:subClassOf ns1:E1_CRM_Entity .

    ns1:E7_Activity a rdfs:Class ;
        rdfs:subClassOf ns1:E5_Event .

    ns1:E89_Propositional_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E28_Conceptual_Object .

    ns1:E90_Symbolic_Object a rdfs:Class ;
        rdfs:subClassOf ns1:E28_Conceptual_Object,
            ns1:E72_Legal_Object .

    ns1:E92_Spacetime_Volume a rdfs:Class ;
        rdfs:subClassOf ns1:E1_CRM_Entity .

    <http://www.cidoc-crm.org/extensions/crminf/I1_Argumentation> a rdfs:Class ;
        rdfs:subClassOf ns1:E7_Activity .

    <http://www.cidoc-crm.org/extensions/crminf/I2_Belief> a rdfs:Class ;
        rdfs:subClassOf ns1:E2_Temporal_Entity .

    <http://www.cidoc-crm.org/extensions/crminf/I3_Inference_Logic> a rdfs:Class ;
        rdfs:subClassOf ns1:E89_Propositional_Object .

    <http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set> a rdfs:Class ;
        rdfs:subClassOf ns1:E89_Propositional_Object .

    <http://www.cidoc-crm.org/extensions/crminf/I5_Inference_Making> a rdfs:Class ;
        rdfs:subClassOf <http://www.cidoc-crm.org/extensions/crminf/I1_Argumentation> .

    <http://www.cidoc-crm.org/extensions/crminf/I7_Belief_Adoption> a rdfs:Class ;
        rdfs:subClassOf <http://www.cidoc-crm.org/extensions/crminf/I1_Argumentation> .

    <http://example.org/dectective/profile#ActualJourney> a owl:Class ;
        rdfs:subClassOf <http://example.org/dectective/profile#Journey> ;
        owl:disjointWith <http://example.org/dectective/profile#PretendedJourney> .

    <http://example.org/dectective/profile#ExpectedToReturn> a owl:Class ;
        rdfs:comment "Person whom the believer expects to come back (used only inside belief worlds)." ;
        rdfs:subClassOf ns1:E21_Person .

    <http://example.org/dectective/profile#VoluntaryDisappearance> a owl:Class ;
        rdfs:subClassOf <http://example.org/dectective/profile#Disappearance> ;
        owl:disjointWith <http://example.org/dectective/profile#InvoluntaryDisappearance> .

    <http://example.org/dectective/profile#WeakSighted> a owl:Class ;
        rdfs:subClassOf ns1:E21_Person ;
        owl:disjointWith <http://example.org/dectective/profile#KeenSighted> .

    <http://example.org/dectective/profile#addressee> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#CommunicativeAct> ;
        rdfs:range ns1:E39_Actor .

    <http://example.org/dectective/profile#assisted> a owl:ObjectProperty ;
        rdfs:subPropertyOf ns1:P11i_participated_in .

    <http://example.org/dectective/profile#attended> a owl:ObjectProperty ;
        rdfs:domain ns1:E21_Person ;
        rdfs:range ns1:E5_Event .

    <http://example.org/dectective/profile#believes> a owl:ObjectProperty ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set> .

    <http://example.org/dectective/profile#conjectures> a owl:ObjectProperty ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set> .

    <http://example.org/dectective/profile#disappearedPerson> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#Disappearance> ;
        rdfs:subPropertyOf ns1:P11_had_participant .

    <http://example.org/dectective/profile#employedBy> a owl:ObjectProperty ;
        rdfs:domain ns1:E21_Person ;
        rdfs:range ns1:E74_Group .

    <http://example.org/dectective/profile#engagedTo> a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:domain ns1:E21_Person ;
        rdfs:range ns1:E21_Person .

    <http://example.org/dectective/profile#establishes> a owl:ObjectProperty ;
        rdfs:comment "The actor's account accepted by the narrative as part of the reference reconstruction." ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set> .

    <http://example.org/dectective/profile#hasContent> a owl:ObjectProperty ;
        rdfs:comment "The proposition set communicated (encoded as a named graph). Communicating it does not imply belief." ;
        rdfs:domain <http://example.org/dectective/profile#CommunicativeAct> ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set> .

    <http://example.org/dectective/profile#hasDefectProfile> a owl:ObjectProperty ;
        rdfs:comment "Set of typing defects of a machine. Making it owl:InverseFunctionalProperty encodes Holmes's individuality principle (P116.S01-S02); that axiom is NOT shared: it lives only in the worlds that adopt it." ;
        rdfs:domain <http://example.org/dectective/profile#Typewriter> .

    <http://example.org/dectective/profile#hasOccupation> a owl:ObjectProperty ;
        rdfs:domain ns1:E21_Person ;
        rdfs:range <http://example.org/dectective/profile#Occupation> .

    <http://example.org/dectective/profile#heldBy> a owl:ObjectProperty ;
        rdfs:comment "Local shortcut: holder of a belief (CRMinf links it only indirectly via I1/I7 P14 and J2)." ;
        rdfs:domain <http://www.cidoc-crm.org/extensions/crminf/I2_Belief> ;
        rdfs:range ns1:E39_Actor .

    <http://example.org/dectective/profile#motive> a owl:ObjectProperty .

    <http://example.org/dectective/profile#purportsToBeFrom> a owl:ObjectProperty ;
        rdfs:comment "Apparent sender as shown on the document; not authorship." ;
        rdfs:domain <http://example.org/dectective/profile#Letter> .

    <http://example.org/dectective/profile#purpose> a owl:ObjectProperty .

    <http://example.org/dectective/profile#rejects> a owl:ObjectProperty .

    <http://example.org/dectective/profile#reportedBy> a owl:ObjectProperty ;
        rdfs:comment "Who reports the act in the text (e.g. Mary reporting Hosmer's words)." ;
        rdfs:domain <http://example.org/dectective/profile#CommunicativeAct> ;
        rdfs:range ns1:E39_Actor .

    <http://example.org/dectective/profile#showsDefectProfile> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#TypewrittenLetter> .

    <http://example.org/dectective/profile#spouseOf> a owl:ObjectProperty,
            owl:SymmetricProperty .

    <http://example.org/dectective/profile#stepfatherOf> a owl:ObjectProperty ;
        rdfs:domain ns1:E21_Person ;
        rdfs:range ns1:E21_Person .

    <http://example.org/dectective/profile#traveller> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#Journey> ;
        rdfs:subPropertyOf ns1:P14_carried_out_by .

    <http://example.org/dectective/profile#typedOn> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#TypewrittenLetter> ;
        rdfs:range <http://example.org/dectective/profile#Typewriter> .

    <http://example.org/dectective/profile#usedAppellation> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#Impersonation> ;
        rdfs:range ns1:E41_Appellation .

    <http://example.org/dectective/profile#usedBy> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#Typewriter> .

    <http://example.org/dectective/profile#uttered> a owl:ObjectProperty ;
        rdfs:comment "Verbatim content of a communicative act; no commitment of the speaker implied." ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set> .

    <http://example.org/dectective/profile#wore> a owl:ObjectProperty ;
        rdfs:domain ns1:E21_Person .

    <http://example.org/dectective/profile#writtenBy> a owl:ObjectProperty ;
        rdfs:domain <http://example.org/dectective/profile#Letter> ;
        rdfs:range ns1:E21_Person .

    ns1:P1_is_identified_by a rdf:Property ;
        rdfs:domain ns1:E1_CRM_Entity ;
        rdfs:range ns1:E41_Appellation ;
        owl:inverseOf ns1:P1i_identifies .

    ns1:P4_has_time-span a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E52_Time-Span ;
        owl:inverseOf ns1:P4i_is_time-span_of .

    <http://www.cidoc-crm.org/extensions/crminf/J1_used_as_premise> a rdf:Property ;
        rdfs:domain <http://www.cidoc-crm.org/extensions/crminf/I5_Inference_Making> ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I2_Belief> ;
        rdfs:subPropertyOf ns1:P17_was_motivated_by ;
        owl:inverseOf <http://www.cidoc-crm.org/extensions/crminf/J1i_was_premise_for> .

    <http://www.cidoc-crm.org/extensions/crminf/J2_concluded_that> a rdf:Property ;
        rdfs:domain <http://www.cidoc-crm.org/extensions/crminf/I1_Argumentation> ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I2_Belief> ;
        rdfs:subPropertyOf ns1:P175_starts_before_or_with_the_start_of,
            ns1:P175i_starts_after_or_with_the_start_of,
            ns1:P185_ends_before_the_end_of ;
        owl:inverseOf <http://www.cidoc-crm.org/extensions/crminf/J2i_was_concluded_by> .

    <http://www.cidoc-crm.org/extensions/crminf/J3_applied> a rdf:Property ;
        rdfs:domain <http://www.cidoc-crm.org/extensions/crminf/I5_Inference_Making> ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I3_Inference_Logic> ;
        rdfs:subPropertyOf ns1:P16_used_specific_object ;
        owl:inverseOf <http://www.cidoc-crm.org/extensions/crminf/J3i_was_applied_by> .

    <http://www.cidoc-crm.org/extensions/crminf/J4_that> a rdf:Property ;
        rdfs:domain <http://www.cidoc-crm.org/extensions/crminf/I2_Belief> ;
        rdfs:range <http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set> ;
        owl:inverseOf <http://www.cidoc-crm.org/extensions/crminf/J4i_is_subject_of> .

    <http://www.cidoc-crm.org/extensions/crminf/J5_holds_to_be> a rdf:Property ;
        rdfs:domain <http://www.cidoc-crm.org/extensions/crminf/I2_Belief> .

    <http://www.cidoc-crm.org/extensions/crminf/J7_is_based_on_evidence_from> a rdf:Property ;
        rdfs:domain <http://www.cidoc-crm.org/extensions/crminf/I7_Belief_Adoption> ;
        rdfs:range ns1:E73_Information_Object ;
        rdfs:subPropertyOf ns1:P16_used_specific_object ;
        owl:inverseOf <http://www.cidoc-crm.org/extensions/crminf/J7i_is_evidence_for> .

    <http://example.org/dectective/profile#Impersonation> a owl:Class ;
        rdfs:comment "Acting under a persona identified by an appellation that is not one's own." ;
        rdfs:subClassOf ns1:E7_Activity .

    <http://example.org/dectective/profile#InvoluntaryDisappearance> a owl:Class ;
        rdfs:subClassOf <http://example.org/dectective/profile#Disappearance> .

    <http://example.org/dectective/profile#KeenSighted> a owl:Class ;
        rdfs:subClassOf ns1:E21_Person .

    <http://example.org/dectective/profile#Occupation> a owl:Class ;
        rdfs:subClassOf ns1:E55_Type .

    <http://example.org/dectective/profile#PretendedJourney> a owl:Class ;
        rdfs:comment "A journey announced but not performed." ;
        rdfs:subClassOf <http://example.org/dectective/profile#Journey> .

    ns1:P14_carried_out_by a rdf:Property ;
        rdfs:domain ns1:E7_Activity ;
        rdfs:range ns1:E39_Actor ;
        rdfs:subPropertyOf ns1:P11_had_participant ;
        owl:inverseOf ns1:P14i_performed .

    ns1:P17_was_motivated_by a rdf:Property ;
        rdfs:domain ns1:E7_Activity ;
        rdfs:range ns1:E1_CRM_Entity ;
        rdfs:subPropertyOf ns1:P15_was_influenced_by ;
        owl:inverseOf ns1:P17i_motivated .

    ns1:P184_ends_before_or_with_the_end_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        rdfs:subPropertyOf ns1:P174_starts_before_the_end_of ;
        owl:inverseOf ns1:P184i_ends_with_or_after_the_end_of .

    ns1:P185_ends_before_the_end_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        rdfs:subPropertyOf ns1:P184_ends_before_or_with_the_end_of ;
        owl:inverseOf ns1:P185i_ends_after_the_end_of .

    <http://example.org/dectective/profile#TypewrittenLetter> a owl:Class ;
        rdfs:subClassOf <http://example.org/dectective/profile#Letter> .

    ns1:P11i_participated_in a rdf:Property ;
        rdfs:domain ns1:E39_Actor ;
        rdfs:range ns1:E5_Event ;
        rdfs:subPropertyOf ns1:P12i_was_present_at ;
        owl:inverseOf ns1:P11_had_participant .

    ns1:P12i_was_present_at a rdf:Property ;
        rdfs:domain ns1:E77_Persistent_Item ;
        rdfs:range ns1:E5_Event ;
        owl:inverseOf ns1:P12_occurred_in_the_presence_of .

    ns1:P15_was_influenced_by a rdf:Property ;
        rdfs:domain ns1:E7_Activity ;
        rdfs:range ns1:E1_CRM_Entity ;
        owl:inverseOf ns1:P15i_influenced .

    ns1:P16_used_specific_object a rdf:Property ;
        rdfs:domain ns1:E7_Activity ;
        rdfs:range ns1:E70_Thing ;
        rdfs:subPropertyOf ns1:P12_occurred_in_the_presence_of,
            ns1:P15_was_influenced_by ;
        owl:inverseOf ns1:P16i_was_used_for .

    ns1:P173_starts_before_or_with_the_end_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        owl:inverseOf ns1:P173i_ends_after_or_with_the_start_of .

    ns1:P173i_ends_after_or_with_the_start_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        owl:inverseOf ns1:P173_starts_before_or_with_the_end_of .

    ns1:P174i_ends_after_the_start_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        rdfs:subPropertyOf ns1:P173i_ends_after_or_with_the_start_of ;
        owl:inverseOf ns1:P174_starts_before_the_end_of .

    ns1:P175_starts_before_or_with_the_start_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        rdfs:subPropertyOf ns1:P174_starts_before_the_end_of ;
        owl:inverseOf ns1:P175i_starts_after_or_with_the_start_of .

    ns1:P175i_starts_after_or_with_the_start_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        rdfs:subPropertyOf ns1:P174i_ends_after_the_start_of ;
        owl:inverseOf ns1:P175_starts_before_or_with_the_start_of .

    <http://example.org/dectective/profile#CommunicativeAct> a owl:Class ;
        rdfs:comment "An act of telling or writing addressed to someone. Unlike crminf:I1 Argumentation (and E13, a subclass of I1 in CRMinf 1.2.1) it does NOT presuppose sincerity: the speaker's belief in the content is represented separately, if at all." ;
        rdfs:subClassOf ns1:E7_Activity .

    <http://example.org/dectective/profile#Disappearance> a owl:Class ;
        rdfs:subClassOf ns1:E5_Event .

    <http://example.org/dectective/profile#Journey> a owl:Class ;
        rdfs:subClassOf ns1:E7_Activity .

    <http://example.org/dectective/profile#Letter> a owl:Class ;
        rdfs:subClassOf ns1:E22_Human-Made_Object .

    <http://example.org/dectective/profile#Typewriter> a owl:Class ;
        rdfs:subClassOf ns1:E22_Human-Made_Object .

    ns1:P11_had_participant a rdf:Property ;
        rdfs:domain ns1:E5_Event ;
        rdfs:range ns1:E39_Actor ;
        rdfs:subPropertyOf ns1:P12_occurred_in_the_presence_of ;
        owl:inverseOf ns1:P11i_participated_in .

    ns1:P12_occurred_in_the_presence_of a rdf:Property ;
        rdfs:domain ns1:E5_Event ;
        rdfs:range ns1:E77_Persistent_Item ;
        owl:inverseOf ns1:P12i_was_present_at .

    ns1:P174_starts_before_the_end_of a rdf:Property ;
        rdfs:domain ns1:E2_Temporal_Entity ;
        rdfs:range ns1:E2_Temporal_Entity ;
        rdfs:subPropertyOf ns1:P173_starts_before_or_with_the_end_of ;
        owl:inverseOf ns1:P174i_ends_after_the_start_of .
}

{
    <http://example.org/dectective/story/app_windibank> a ns1:E41_Appellation ;
        rdfs:label "Windibank" .

    <http://example.org/dectective/story/holmes> a ns1:E21_Person .

    <http://example.org/dectective/story/hosmer> a ns1:E21_Person ;
        ns1:P1_is_identified_by <http://example.org/dectective/story/app_hosmer_angel> .

    <http://example.org/dectective/story/mary> a ns1:E21_Person ;
        ns1:P1_is_identified_by <http://example.org/dectective/story/app_mary_sutherland> .

    <http://example.org/dectective/story/mother> a ns1:E21_Person .

    <http://example.org/dectective/story/watson> a ns1:E21_Person .

    <http://example.org/dectective/story/windibank> a ns1:E21_Person .

    <http://example.org/dectective/world/shared> a <http://w3id.org/conjectures/sharedWorld> .

    <http://example.org/dectective/profile#believes> a <http://w3id.org/conjectures/doxasticPredicate> .

    <http://example.org/dectective/profile#conjectures> a <http://w3id.org/conjectures/conjecturalPredicate> .

    <http://example.org/dectective/profile#establishes> a <http://w3id.org/conjectures/epistemicPredicate> .

    <http://example.org/dectective/profile#uttered> a <http://w3id.org/conjectures/verbatimPredicate> .

    <http://example.org/dectective/story/app_hosmer_angel> a ns1:E41_Appellation ;
        rdfs:label "Hosmer Angel" .

    <http://example.org/dectective/story/app_mary_sutherland> a ns1:E41_Appellation ;
        rdfs:label "Mary Sutherland" .
}

