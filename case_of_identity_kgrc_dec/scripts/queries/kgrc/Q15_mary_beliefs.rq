PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX kgc: <http://kgc.knowledge-graph.jp/ontology/kgc.owl#>
PREFIX pred: <http://kgc.knowledge-graph.jp/data/predicate/>
PREFIX d: <http://kgc.knowledge-graph.jp/data/ACaseOfIdentity/>
# Scenes whose subject is Sutherland and whose predicate is mental/commissive, or whose infoSource is Sutherland and type Thought
SELECT DISTINCT ?s ?type ?p ?src ?info WHERE {
  ?s rdf:type ?type .
  { ?s kgc:subject d:Sutherland ; kgc:hasPredicate ?p .
    FILTER(REGEX(STR(?p), "/predicate/(believe|think|wait|swear|promise|know|notKnow|want|hope|worry|wonder|suspect|beTrue|keep|love)")) }
  UNION { ?s rdf:type kgc:Thought ; kgc:infoSource d:Sutherland . OPTIONAL { ?s kgc:hasPredicate ?p } }
  OPTIONAL { ?s kgc:source ?src FILTER(lang(?src)="en") }
  OPTIONAL { ?s kgc:infoSource ?info }
} ORDER BY ?s
