PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX kgc: <http://kgc.knowledge-graph.jp/ontology/kgc.owl#>
PREFIX pred: <http://kgc.knowledge-graph.jp/data/predicate/>
PREFIX d: <http://kgc.knowledge-graph.jp/data/ACaseOfIdentity/>
# Any explicit identity encoding involving Hosmer/Windibank: owl:sameAs, equalTo, hasProperty pred:Hosmer
SELECT ?s ?p ?o ?src ?info WHERE {
  { ?s owl:sameAs ?o . BIND(owl:sameAs AS ?p) }
  UNION { ?s kgc:hasProperty pred:Hosmer . BIND(kgc:hasProperty AS ?p) BIND(pred:Hosmer AS ?o) }
  UNION { ?s kgc:hasPredicate pred:equalTo ; kgc:what ?o . BIND(pred:equalTo AS ?p) }
  OPTIONAL { ?s kgc:source ?src FILTER(lang(?src)="en") }
  OPTIONAL { ?s kgc:infoSource ?info }
}
