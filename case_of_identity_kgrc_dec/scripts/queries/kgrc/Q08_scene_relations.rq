PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX kgc: <http://kgc.knowledge-graph.jp/ontology/kgc.owl#>
PREFIX pred: <http://kgc.knowledge-graph.jp/data/predicate/>
PREFIX d: <http://kgc.knowledge-graph.jp/data/ACaseOfIdentity/>
# Relations between scenes (both ends typed as scenes)
SELECT ?rel (COUNT(*) AS ?n) WHERE {
  ?a ?rel ?b .
  ?a rdf:type ?ta . FILTER(?ta IN (kgc:Statement, kgc:Situation, kgc:Thought))
  ?b rdf:type ?tb . FILTER(?tb IN (kgc:Statement, kgc:Situation, kgc:Thought))
} GROUP BY ?rel ORDER BY DESC(?n)
